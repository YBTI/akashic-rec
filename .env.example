# ===== Supabase(Project Settings > API) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===== AI =====
# テスト中は gemini、本番は anthropic に切り替え
AI_PROVIDER=gemini

# Gemini(Google AI Studio で発行)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_QUESTION_MODEL=gemini-2.5-flash
GEMINI_ARTICLE_MODEL=gemini-2.5-flash

# Claude(Anthropic Console で発行)
ANTHROPIC_API_KEY=
ANTHROPIC_QUESTION_MODEL=claude-haiku-5-5
ANTHROPIC_ARTICLE_MODEL=claude-sonnet-5-5

# 1人1日あたりのAI呼び出し上限(質問1回・記事化1回をそれぞれ1回と数える)
AI_DAILY_LIMIT=30
